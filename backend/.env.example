# AI provider keys
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Groq task-specific chat models
GROQ_MODEL_INTERVIEW=openai/gpt-oss-120b
GROQ_MODEL_ANALYSIS=qwen/qwen3.8-27b
GROQ_MODEL_RESUME=qwen/qwen3.8-27b
GROQ_MODEL_FEEDBACK=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3

# Optional OpenAI fallback
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Coding Lab execution
# auto: local on your machine, Judge0 on Vercel
# local: use installed Python/Node/Java runtimes
# judge0: always use the remote sandbox
CODE_EXECUTION_PROVIDER=auto
JUDGE0_URL=https://ce.judge0.com
# For RapidAPI, set the key and host. For self-hosted Judge0 with auth, set only JUDGE0_API_KEY.
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=

