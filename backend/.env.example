# AI provider keys
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Groq task-specific chat models
GROQ_MODEL_INTERVIEW=openai/gpt-oss-120b
GROQ_MODEL_ANALYSIS=qwen/qwen3.8-27b
GROQ_MODEL_RESUME=qwen/qwen3.8-27b
